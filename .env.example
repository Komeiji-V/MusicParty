# ===========================================
# MusicParty 环境变量配置
# 复制此文件为 .env 并修改
# ===========================================

# --- 数据库 (PostgreSQL，独立部署) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=musicparty
DB_USER=musicparty
DB_PASSWORD=musicparty

# --- 统一认证中心 (自研统一登录平台 C:\Project\Auth) ---
# 认证中心地址（后端代理 + 前端跳转登录页）
AUTH_CENTER_URL=http://localhost:8000
# JWT_SECRET 必须与认证中心 .env 中的 JWT_SECRET 完全一致（共享密钥，用于本地验签）
# 认证中心生成方法：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_SAME_AS_AUTH_CENTER

# --- 基础配置 ---
BASE_URL=http://localhost:8848
APP_AUTHOR_NAME=ThorNex
APP_BACK_WORDS=MUSIC PARTY

# --- 音乐源 API 地址 ---
NETEASE_API_URL=http://netease-api:3000
QQ_API_URL=http://qq-api:3200

# --- 音源开关 ---
NETEASE_ENABLED=true
QQ_ENABLED=true
KUGOU_ENABLED=true
BILIBILI_ENABLED=true

# --- 平台凭证 ---
NETEASE_COOKIE=
NETEASE_QUALITY=exhigh
QQ_COOKIE=
QQ_QUALITY=320
KUGOU_COOKIE=
BILIBILI_SESSDATA=

# --- 队列/聊天配置 ---
QUEUE_MAX_SIZE=1000
QUEUE_HISTORY_SIZE=50
QUEUE_MAX_USER_SONGS=100
PLAYLIST_IMPORT_LIMIT=100
CHAT_HISTORY_LIMIT=1000
CHAT_MIN_INTERVAL=1000
CHAT_MAX_LENGTH=200
CACHE_MAX_SIZE=1GB

# --- 防滥用 ---
AUTH_RATE_LIMIT_ENABLED=true
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=60
AUTH_BLOCK_DURATION=300

# ===========================================
# 注意：
# 1. 认证中心 CORS_ORIGINS 需加入 MusicParty 域名（登录回跳白名单），
#    如：CORS_ORIGINS=http://localhost:8848
# 2. 认证中心角色 admin 的用户登录后自动成为 MusicParty 总管理员
# ===========================================
