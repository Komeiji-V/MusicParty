# ===========================================
# MusicParty 环境变量配置
# 复制此文件为 .env 并修改（生产模板见 docs/DEPLOY.md 第三节）
# ===========================================

# --- 基础 ---
# 后端监听端口（生产经反代 443 → 8080）
SERVER_PORT=8080
# 对外访问地址（用于生成直播流链接等绝对 URL）
BASE_URL=http://localhost:8848

# --- 数据库 (PostgreSQL，独立部署) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=musicparty
DB_USER=musicparty
# 生产：使用最小权限专用账号 + 32 字节随机口令，勿用默认值
DB_PASSWORD=musicparty

# --- 统一认证中心 (自研统一登录平台) ---
# 认证中心地址（生产必须 https）
AUTH_CENTER_URL=http://localhost:8000
# JWT_SECRET 必须与认证中心 .env 中的 JWT_SECRET 完全一致（共享密钥，本地验签）
# 生成方式：openssl rand -hex 32
# 注意：缺失/使用占位符将拒绝启动（JwtUtil 黑名单校验）
JWT_SECRET=CHANGE_ME_SAME_AS_AUTH_CENTER

# --- Cookie 加密（生产必配，与 JWT_SECRET 完全独立，勿复用） ---
# 生成方式：openssl rand -hex 32；缺失时回退 JWT_SECRET 派生并打启动告警（仅限本地）
COOKIE_ENCRYPTION_KEY=

# --- 超管白名单（生产必配） ---
# 逗号分隔的 auth-center 用户 id（auth-center users 表 id）。
# 非空时仅白名单内的 admin 角色可成为本站总管理员；留空 = 信任认证中心角色
SUPER_ADMIN_AUTH_UIDS=

# --- CORS 白名单（生产必配：本站生产域名；auth-center origin 会自动并入） ---
CORS_ALLOWED_ORIGINS=http://localhost:8848,http://localhost:8080

# --- 音乐源 API 地址（生产仅内网可达，勿暴露公网） ---
NETEASE_API_URL=http://netease-api:3000
QQ_API_URL=http://qq-api:3200

# --- 音源开关 ---
NETEASE_ENABLED=true
QQ_ENABLED=true
KUGOU_ENABLED=true
BILIBILI_ENABLED=true

# --- 平台凭证（会员音源所需；提交后进入加密 Cookie 池） ---
NETEASE_COOKIE=
NETEASE_QUALITY=exhigh
QQ_COOKIE=
QQ_QUALITY=320
KUGOU_COOKIE=
BILIBILI_SESSDATA=

# --- 队列/聊天配置 ---
QUEUE_MAX_SIZE=1000
QUEUE_HISTORY_SIZE=50
QUEUE_MAX_USER_SONGS=100
PLAYLIST_IMPORT_LIMIT=100
CHAT_HISTORY_LIMIT=1000
CHAT_MIN_INTERVAL=1000
CHAT_MAX_LENGTH=200
CACHE_MAX_SIZE=1GB

# ===========================================
# 安全说明：
# 1. JWT_SECRET 与 COOKIE_ENCRYPTION_KEY 必须独立随机生成并单独保管（备份不含密钥）
# 2. 认证中心 CORS_ORIGINS 需包含本站域名（登录回跳白名单），如 CORS_ORIGINS=https://musicparty.example.com
# 3. 生产必须 HTTPS 反代 + X-Forwarded-For 覆写（见 docs/DEPLOY.md），后端端口不得直连公网
# 4. 认证中心角色 admin 的用户登录后是否成为总管理员，由 SUPER_ADMIN_AUTH_UIDS 白名单决定
# ===========================================
